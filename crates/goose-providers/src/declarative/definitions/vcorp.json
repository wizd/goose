{
  "name": "vcorp",
  "engine": "openai",
  "display_name": "VCorp",
  "description": "VCorp OpenAI-compatible API relay / aggregation gateway",
  "api_key_env": "VCORP_API_KEY",
  "base_url": "${VCORP_BASE_URL}",
  "env_vars": [
    {
      "name": "VCORP_BASE_URL",
      "required": false,
      "secret": false,
      "default": "https://api.vcorp.ai/v1/chat/completions",
      "description": "VCorp OpenAI-compatible chat completions URL (include /v1/chat/completions)."
    }
  ],
  "models": [
    {
      "name": "google/gemini-3.8-flash",
      "context_limit": 1000000,
      "max_tokens": 8192
    }
  ],
  "dynamic_models": true,
  "skip_canonical_filtering": true,
  "supports_streaming": true,
  "model_doc_link": "https://api.vcorp.ai/v1/models",
  "requires_auth": true,
  "setup": {
    "category": "model",
    "setup_method": "single_api_key",
    "group": "additional",
    "docs_url": "https://api.vcorp.ai",
    "aliases": ["vcorp.ai", "vcorp-relay"]
  }
}
